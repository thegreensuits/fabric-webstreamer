{
  "schemaVersion": 1,
  "id": "webstreamer",
  "version": "${version}",

  "name": "WebStreamer",
  "description": "Client-side virtual displays: watch Twitch/HLS streams on in-game screens, driven by the server (TheGentleSuits viewing party). Remake of fabric-webstreamer by Theo Rozier.",
  "authors": [
    "TheGentleSuits",
    "Theo Rozier (Mindstorm38) — original fabric-webstreamer"
  ],
  "contact": {
    "sources": "https://github.com/theorzr/fabric-webstreamer"
  },

  "license": "LGPL-3.0-only",

  "environment": "client",
  "entrypoints": {
    "client": [
      "fr.thegentlesuits.webstreamer.WebStreamerClient"
    ]
  },

  "depends": {
    "fabricloader": ">=0.20.0",
    "fabric-api": "*",
    "minecraft": "~26.3",
    "java": ">=25"
  }
}
